<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/payu_bottom_sheet_rounded_corner"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.btjnonbrokerage.Fragment.BottomSheet.HomeSelectLocationFragment">

    <ImageView
        android:id="@+id/image_slide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_19sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:src="@drawable/slide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tv_select_loc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#234F68"
        android:textSize="@dimen/_20sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="Select Location"

        app:layout_constraintTop_toBottomOf="@id/image_slide"
        android:layout_marginTop="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_35sdp"
        android:backgroundTint="#234F68"
        android:paddingHorizontal="@dimen/_30sdp"
        app:cardCornerRadius="@dimen/_19sdp"
        app:layout_constraintTop_toTopOf="@id/tv_select_loc"
        app:layout_constraintBottom_toBottomOf="@id/tv_select_loc"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_5sdp"

        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/poppins"
            />



    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_blue_location"
        android:layout_width="0dp"
        android:layout_height="@dimen/_70sdp"
        app:cardCornerRadius="@dimen/_20sdp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_select_loc"
        android:layout_marginTop="@dimen/_20sdp"
        android:backgroundTint="#234F68"

        >

       <com.google.android.flexbox.FlexboxLayout
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           >
           <androidx.constraintlayout.widget.ConstraintLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               >
               <androidx.cardview.widget.CardView
                   android:layout_width="@dimen/_40sdp"
                   android:layout_height="@dimen/_40sdp"
                   app:cardCornerRadius="@dimen/_30sdp"
                   android:backgroundTint="#ECEDF3"
                   android:id="@+id/card_location"
                   app:layout_constraintStart_toStartOf="parent"
                   app:layout_constraintTop_toTopOf="parent"
                   app:layout_constraintBottom_toBottomOf="parent"
                   android:layout_marginStart="@dimen/_20sdp"
                   >
                   <ImageView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:src="@drawable/baseline_location_on_24"
                       android:layout_gravity="center"
                       />
               </androidx.cardview.widget.CardView>

               <TextView
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:text="Srengseng, Kembangan, West Jakarta City, Jakarta 11630"
                   android:textColor="@color/white"
                   android:textSize="@dimen/_10sdp"
                   android:layout_margin="@dimen/_10sdp"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintStart_toEndOf="@id/card_location"
                   app:layout_constraintTop_toTopOf="@id/card_location"
                   app:layout_constraintBottom_toBottomOf="@id/card_location"
                   />



           </androidx.constraintlayout.widget.ConstraintLayout>
       </com.google.android.flexbox.FlexboxLayout>

    </androidx.cardview.widget.CardView>
    
    
    



    <androidx.cardview.widget.CardView
        android:id="@+id/card_white_location"
        android:layout_width="0dp"
        android:layout_height="@dimen/_70sdp"
        app:cardCornerRadius="@dimen/_20sdp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_blue_location"
        android:layout_marginTop="@dimen/_10sdp"
        >
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                app:cardCornerRadius="@dimen/_30sdp"
                android:backgroundTint="#ECEDF3"
                android:id="@+id/card_location2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="@dimen/_20sdp"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_location_on_24"
                    android:layout_gravity="center"
                    />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Srengseng, Kembangan, West Jakarta City, Jakarta 11630"
                 android:textColor="#53587A"
                android:textSize="@dimen/_10sdp"
                android:layout_margin="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_location2"
                app:layout_constraintTop_toTopOf="@id/card_location2"
                app:layout_constraintBottom_toBottomOf="@id/card_location2"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.flexbox.FlexboxLayout>
    </androidx.cardview.widget.CardView>
    
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="77dp"
        app:layout_constraintTop_toBottomOf="@id/card_white_location"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.7"
        app:cardCornerRadius="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:backgroundTint="#8BC83F"
        android:layout_marginBottom="@dimen/_30sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="Choose Location"
            android:textSize="20dp"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins"
            />
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>