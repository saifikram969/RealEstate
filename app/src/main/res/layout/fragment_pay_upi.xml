<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.MainFragment.PayUpiFr                                                                                                                                                                                                                                                                                                                                                                        agment">

   <LinearLayout
       android:orientation="vertical"
       android:layout_width="match_parent"
       android:layout_height="wrap_content">



       <LinearLayout
           android:id="@+id/ln2"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical">
           <TextView
               android:layout_marginStart="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:fontFamily="@font/poppins_bold"
               android:text="Enter UPI ID" />
           <EditText
               android:id="@+id/upiid"
               style="@style/editTextNonBrokerage"
               android:hint="example@bhim"
               android:drawableStart="@drawable/mdi_account_key_outline"
               android:inputType="text"/>
           <TextView
               android:layout_marginStart="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:fontFamily="@font/poppins_bold"
               android:text="BHK Type" />
           <TextView
               android:id="@+id/tv_bhk"
               style="@style/editTextNonBrokerage"
               android:hint="1RK"
               android:gravity="center"
               android:textAlignment="textStart"
               android:drawableStart="@drawable/bx_home"
               tools:ignore="RtlCompat" />
           <TextView
               android:layout_marginStart="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:fontFamily="@font/poppins_bold"
               android:text="Property Address" />
           <EditText
               android:id="@+id/address"
               style="@style/editTextNonBrokerage"
               android:hint="Enter address"
               android:drawableStart="@drawable/mdi_account_key_outline"
               android:inputType="text"/>
           <TextView
               android:layout_marginStart="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:fontFamily="@font/poppins_bold"
               android:text="Rent Amount" />
           <EditText
               android:id="@+id/rentamountupi"
               style="@style/editTextNonBrokerage"
               android:hint="Enter amount"
               android:drawableStart="@drawable/ic_baseline_currency_rupee"
               android:inputType="number"
               android:maxLength="9" />
           <TextView
               android:layout_marginStart="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:fontFamily="@font/poppins_bold"
               android:text="Beneficiary's PAN" />
           <EditText
               android:id="@+id/et_beneficiary_pan"
               style="@style/editTextNonBrokerage"
               android:hint="Enter your beneficiary's PAN"
               android:drawableStart="@drawable/solar_card_2_outline"
               android:inputType="textCapCharacters"
               android:textAllCaps="true"
               android:maxLength="10"/>
           <TextView
               android:layout_marginStart="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:fontFamily="@font/poppins_bold"
               android:text="Tenant's PAN (Required if amount > 50k)" />
           <EditText
               android:id="@+id/tenantpanupi"
               style="@style/editTextNonBrokerage"
               android:hint="Enter your own PAN number"
               android:drawableStart="@drawable/solar_card_2_outline"
               android:inputType="textCapCharacters"
               android:textAllCaps="true"
               android:maxLength="10"/>


           <TextView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginStart="@dimen/_10sdp"
               android:fontFamily="@font/poppins_bold"
               android:text="Choose payment type" />

           <LinearLayout
               android:layout_margin="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal">

               <LinearLayout
                   android:id="@+id/ll_normal_payment"
                   android:orientation="horizontal"
                   android:layout_weight="@integer/material_motion_duration_long_1"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content">

                   <ImageView
                       android:id="@+id/iv_normal_Payment"
                       android:layout_width="@dimen/_24sdp"
                       android:layout_height="@dimen/_24sdp"
                       android:src="@drawable/radioselected" />

                   <TextView
                       android:fontFamily="@font/poppins_semibold"
                       android:layout_gravity="center"
                       android:layout_marginStart="@dimen/_2sdp"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Normal Payment" />

               </LinearLayout>

               <LinearLayout
                   android:id="@+id/ll_stander_payment"
                   android:layout_weight="@integer/material_motion_duration_long_1"
                   android:orientation="horizontal"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content">
                   <ImageView
                       android:gravity="center"
                       android:id="@+id/iv_stander_payment"
                       android:layout_width="@dimen/_24sdp"
                       android:layout_height="@dimen/_24sdp"
                       android:button="@drawable/custom_radio_button"
                       android:src="@drawable/radiounselected" />

                   <TextView
                       android:fontFamily="@font/poppins_semibold"
                       android:layout_gravity="center"
                       android:layout_marginStart="@dimen/_2sdp"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Standard Payment " />

               </LinearLayout>




           </LinearLayout>

           <TextView
               android:layout_marginStart="@dimen/_10sdp"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:fontFamily="@font/poppins_bold"
               android:text="Upload Rental Agreement (optional)" />
       </LinearLayout>
       <LinearLayout
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           android:layout_marginBottom="@dimen/_40sdp"
           >
           <TextView
               android:id="@+id/tv_choose_file"
               android:padding="@dimen/_5sdp"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="choose file"
               android:textColor="@color/white"
               android:background="@color/greenCreateAccount"
               android:layout_marginStart="15dp"
               />
           <TextView
               android:id="@+id/tv_file_name"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="No file chosen"
               android:layout_marginStart="9dp"
               />
           <ImageView
               android:id="@+id/imgfetch"
               android:scaleType="fitXY"
               android:layout_width="@dimen/_100sdp"
               android:layout_height="@dimen/_100sdp"/>

       </LinearLayout>

       <TextView
           android:id="@+id/tv_Save_Payment"
           android:layout_width="@dimen/_150sdp"
           android:layout_height="@dimen/_40sdp"
           android:background="@drawable/backgroundcolor"
           android:text="Payment Rent"
           android:textColor="@color/white"
           android:padding="@dimen/_10sdp"
           android:fontFamily="@font/poppins_medium"
           android:layout_marginBottom="@dimen/_70sdp"
           android:layout_gravity="center"
           android:gravity="center"/>
   </LinearLayout>

</ScrollView>