<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.MainFragment.SearchFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/favourite_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/toolbar_back1"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                app:cardBackgroundColor="@color/grayRealEstate"
                app:cardCornerRadius="@dimen/_100sdp"
                app:cardElevation="0dp">

                <ImageView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back" />

            </androidx.cardview.widget.CardView>


            <TextView
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:fontFamily="@font/poppins_medium"
                android:text="Search Result"
                android:textAlignment="center"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_alignParentEnd="true"
                android:id="@+id/cv_search_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_16sdp"
                app:cardBackgroundColor="#F5F4F8"
                app:cardCornerRadius="@dimen/_40sdp"
                app:cardElevation="0dp">

                <ImageView

                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_margin="@dimen/_8sdp"
                    android:src="@drawable/ic_filter" />

            </androidx.cardview.widget.CardView>

        </RelativeLayout>


        <RelativeLayout
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp">
        <EditText
            android:id="@+id/et_search_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:background="@drawable/edittext"
            android:drawableEnd="@drawable/ic_search"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="House, Apartment, etc"
            android:inputType="text"
            android:padding="@dimen/_15sdp"/>

        <ImageView
            android:id="@+id/iv_microphone"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_40sdp"
            android:layout_centerVertical="true"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/microphone"/>
    </RelativeLayout>

        <TextView
            style="@style/addListingTextStyle"
            android:text="BHK Type"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_1rk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="1 RK"/>
            <TextView
                android:id="@+id/tv_1bhk"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="1 BHK"/>

            <TextView
                android:id="@+id/tv_2bhk"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/boldTextColor"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="2 BHK"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_3bhk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="3 BHK"/>
            <TextView
                android:id="@+id/tv_4bhk"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="4 BHK"/>

            <TextView
                android:id="@+id/tv_4bhk_plus"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_width="0dp"
                android:textColor="@color/boldTextColor"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="4+ BHK"/>
        </LinearLayout>

            <TextView
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price Range:"
                android:textColor="@color/Darkblue"
                android:textSize="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"/>
        <LinearLayout
            android:layout_margin="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹"
                android:textColor="@color/Darkblue"
                android:textSize="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"/>
            <TextView
                android:id="@+id/tv_minimum_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:text="0"
                android:textColor="@color/Darkblue"
                android:textSize="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:text="to ₹"
                android:textColor="@color/Darkblue"
                android:textSize="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"/>
            <TextView
                android:id="@+id/tv_maximum_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:text="5,00,000"
                android:textColor="@color/Darkblue"
                android:textSize="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"/>

        </LinearLayout>

       <com.google.android.material.slider.RangeSlider
           android:id="@+id/slider_rangeSlider"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:valueFrom="0"
           android:valueTo="500000"
           app:trackHeight="6dp"/>

        <TextView
            android:id="@+id/tv_availability"
            style="@style/addListingTextStyle"
            android:text="Availability:"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_immediate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="Immediate"/>

            <TextView
                android:id="@+id/tv_within15_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="Within 15 days"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_within30_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="Within 30 days"/>

            <TextView
                android:id="@+id/tv_after_30_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/boldTextColor"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/background_myedit_text"
                android:text="After 30 days"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSearch"
            style="@style/greenButton"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_30sdp"
            android:text="Search" />

        <LinearLayout
            android:id="@+id/ll_not_found"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <androidx.cardview.widget.CardView
                    style="@style/cardview_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/_100sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_not_found"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/linearLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_40sdp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Search "
                    android:textAlignment="center"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="not found"
                    android:textAlignment="center"
                    android:textColor="@color/textAcc"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Click add button above to start exploring and choose your favorite estates."
                android:textAlignment="center"
                android:textColor="#808080"
                app:layout_constraintTop_toBottomOf="@id/linearLayout3"
                tools:layout_editor_absoluteY="647dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView_search"
            app:layout_constraintVertical_bias="0.136" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_100sdp" />


    </LinearLayout>


</androidx.core.widget.NestedScrollView>

