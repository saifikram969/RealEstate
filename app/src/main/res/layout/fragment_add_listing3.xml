<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.btjnonbrokerage.Fragment.AddProperty.AddListingFragment3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">


        <include
            android:id="@+id/common_toolbar"
            layout="@layout/common_toolbar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_40sdp"
                android:fontFamily="@font/poppins_bold"
                android:text="Almost finish ,"
                android:textColor="#1F4C6B"
                android:textSize="@dimen/_20sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_40sdp"
                android:text="complete"
                android:textColor="#252B5C"
                android:textSize="@dimen/_20sdp" />
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="the listing"
            android:textColor="#252B5C"
            android:textSize="@dimen/_20sdp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Rent Price"
            android:textColor="#252B5C"
            android:textSize="@dimen/_15sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp">

            <EditText
                android:id="@+id/et_rent_price"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@null"
                android:hint="₹ 315"
                android:inputType="number"
                android:maxLength="13"
                android:padding="10dp"

                android:textSize="@dimen/_15sdp" />

            />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="110dp"
                android:layout_height="60dp"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/monthlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Monthly"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="110dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Yearly"
                android:textColor="#252B5C" />

        </LinearLayout>

        <TextView
            style="@style/addListingTextStyle"
            android:text="Property Available From" />

        <LinearLayout
            android:id="@+id/ll_available_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/tv_available_from"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@null"
                android:hint="Ex : 12/11/2002"
                android:inputType="number"
                android:padding="10dp"
                android:textSize="@dimen/_15sdp" />

        </LinearLayout>


        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Area" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp">

            <EditText
                android:id="@+id/et_property_area"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@null"
                android:hint="100/sq.ft"
                android:inputType="number"
                android:maxLength="13"
                android:padding="10dp"

                android:textSize="@dimen/_15sdp" />

            />
        </LinearLayout>


        <TextView
            style="@style/addListingTextStyle"
            android:text="Built up Area" />

        <LinearLayout
            android:id="@+id/ll_builtupe_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp">

            <EditText
                android:id="@+id/tv_built_area"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@null"
                android:hint="Sq. ft"
                android:inputType="number"
                android:padding="10dp"
                android:textSize="@dimen/_15sdp" />

        </LinearLayout>




        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Security Deposit" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_10sdp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_15_days"
                android:layout_width="120.8dp"
                android:layout_height="67dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="15 Days"
                android:textColor="#252B5C" />

            <TextView
                android:id="@+id/tv_1_month"
                android:layout_width="168.5dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="1 Month"
                android:textColor="#252B5C" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_2_month"
                android:layout_width="120.8dp"
                android:layout_height="67dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="2 Month"
                android:textColor="#252B5C" />

            <TextView
                android:id="@+id/tv_custom"
                android:layout_width="168.5dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Custom"
                android:textColor="#252B5C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_security_deposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_security_deposit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@null"
                android:hint="4 Month"
                android:inputType="number"
                android:maxLength="13"
                android:padding="10dp"
                android:textSize="@dimen/_15sdp" />

            />
        </LinearLayout>

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Property features" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/et_bedroom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:hint="Bedroom"
                android:inputType="text"
                android:textColorHint="@color/Darkblue"
                android:textSize="@dimen/_15sdp" />

            <ImageView
                android:id="@+id/ivMinusBedroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent1" />

            <TextView
                android:id="@+id/tvNoBedroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="0"
                android:textSize="20dp" />

            <ImageView
                android:id="@+id/ivPlusBedroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/et_bathroom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:hint="Bathroom"
                android:inputType="text"
                android:textColorHint="@color/Darkblue"
                android:textSize="@dimen/_15sdp" />

            <ImageView
                android:id="@+id/ivMinusBathroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent1" />

            <TextView
                android:id="@+id/tvNoBathroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="0"

                android:textSize="20dp" />

            <ImageView
                android:id="@+id/ivPlusBathroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/et_balcony"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:hint="Balcony"
                android:inputType="text"
                android:textColorHint="@color/Darkblue"
                android:textSize="@dimen/_15sdp" />

            <ImageView
                android:id="@+id/ivMinusBalcony"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent1" />

            <TextView
                android:id="@+id/tvNoBalcony"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="0"
                android:textSize="20dp" />

            <ImageView
                android:id="@+id/ivPlusBalcony"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/et_kitchen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:hint="Kitchen"
                android:inputType="text"
                android:textColorHint="@color/Darkblue"
                android:textSize="@dimen/_15sdp" />

            <ImageView
                android:id="@+id/ivMinusKitchen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent1" />

            <TextView
                android:id="@+id/tvNoKitchen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="0"
                android:textSize="20dp" />

            <ImageView
                android:id="@+id/ivPlusKitchen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/et_hall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:hint="Hall"
                android:inputType="text"
                android:textColorHint="@color/Darkblue"
                android:textSize="@dimen/_15sdp" />

            <ImageView
                android:id="@+id/ivMinusHall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent1" />

            <TextView
                android:id="@+id/tvNoHall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="0"
                android:textSize="20dp" />

            <ImageView
                android:id="@+id/ivPlusHall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent" />
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="House facing"
            android:textColor="#252B5C"
            android:textSize="@dimen/_15sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">


            <androidx.cardview.widget.CardView
                android:id="@+id/back_card"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                app:cardBackgroundColor="#A1A5C1"
                app:cardCornerRadius="@dimen/_15sdp">

                <ImageView
                    android:id="@+id/ivBackwardFashing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_arrow_back" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvFashing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:text="North"
                android:textAlignment="center"
                android:textSize="20dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/ForwardCard"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                app:cardBackgroundColor="#A1A5C1"
                app:cardCornerRadius="@dimen/_15sdp">


                <ImageView
                    android:id="@+id/ivForwardFashing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_arrow_forward_ios_24" />

            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <TextView
            style="@style/addListingTextStyle"
            android:text="Environment / Facilities" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_10sdp">

            <TextView
                android:id="@+id/tvParkingLot"
                android:layout_width="120.8dp"
                android:layout_height="67dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Parking Lot"
                android:textColor="#252B5C" />

            <TextView
                android:id="@+id/tvPetAllowed"
                android:layout_width="168.5dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Pet Allowed"
                android:textColor="#252B5C" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGarden"
                    android:layout_width="120.8dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/yearlybuttoncolor"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Garden"
                    android:textColor="#252B5C" />

                <TextView
                    android:id="@+id/tvGym"
                    android:layout_width="120.8dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/yearlybuttoncolor"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Gym"
                    android:textColor="#252B5C" />

                <TextView
                    android:id="@+id/tvPark"
                    android:layout_width="120.8dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/yearlybuttoncolor"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Park"
                    android:textColor="#252B5C" />


            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvFamiliy"
            android:layout_width="168.5dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="@dimen/_10sdp"

            android:background="@drawable/yearlybuttoncolor"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="Kid's familiy"
            android:textColor="#252B5C" />


        <TextView
            style="@style/addListingTextStyle"
            android:text="House Description" />

        <EditText
            android:id="@+id/et_property_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="34dp"
            android:layout_weight="@integer/material_motion_duration_long_1"
            android:background="@drawable/edittext"
            android:gravity="left"
            android:hint="Enter Property Description"
            android:inputType="textMultiLine"
            android:lines="4"
            android:maxLines="5"
            android:padding="@dimen/_15sdp"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:singleLine="false"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/finishbtn"
            style="@style/greenButton"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/_10sdp"
            android:text="Finish" />
    </LinearLayout>
</ScrollView>
