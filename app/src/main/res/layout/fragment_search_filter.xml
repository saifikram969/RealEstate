<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/payu_bottom_sheet_rounded_corner"
    android:orientation="vertical"
    tools:context="com.btjnonbrokerage.Fragment.BottomSheet.SearchFilterFragment">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_19sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:src="@drawable/slide"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="Property category"
        android:textColor="#252B5C"
        android:textSize="@dimen/_15sdp" />
    <LinearLayout
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_category_house"
            android:layout_width="128.8dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/yearlybuttoncolor"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="House"
            android:textColor="#252B5C" />

        <TextView
            android:id="@+id/tv_category_apartment"
            android:layout_width="128.8dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/yearlybuttoncolor"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="Apartment"
            android:textColor="#252B5C" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_category_hotel"
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/yearlybuttoncolor"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="Flat"
            android:textColor="#252B5C" />

        <TextView
            android:id="@+id/tv_category_villa"
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"


            android:background="@drawable/yearlybuttoncolor"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="Villa"
            android:textColor="#252B5C" />

        <TextView
            android:id="@+id/tv_category_cottage"
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/yearlybuttoncolor"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="Cottage"
            android:textColor="#252B5C" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFilter"
        style="@style/greenButton"
        android:layout_width="@dimen/_150sdp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_28sdp"
        android:text="Filter"/>

</LinearLayout>