<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.OTP_Fragment">


    <LinearLayout
        android:background="@color/white"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verification Code"
            android:fontFamily="@font/poppins_bold"
            android:textAlignment="center"
            android:textColor="@color/boldTextColor"
            android:textSize="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_58sdp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please enter the verification code sent \nto your number"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_24sdp"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/text_color"
            android:textSize="@dimen/_12sdp"/>

        <com.chaos.view.PinView
            android:layout_marginBottom="@dimen/_10sdp"
            android:id="@+id/pinviewotp"
            android:layout_centerHorizontal="true"
            app:itemCount="6"
            app:lineWidth="1dp"
            app:itemWidth="@dimen/_35sdp"
            app:itemHeight="@dimen/_35sdp"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:inputType="number"
            android:textColor="@color/black"
            android:itemBackground="@color/grayRealEstate"
            android:cursorVisible="true"
            app:hideLineWhenFilled="false"
            app:itemRadius="10dp"
            style="@style/PinWidget.PinView"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

        </com.chaos.view.PinView>

        <TextView
            android:layout_gravity="center"
            android:id="@+id/tvLetSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_10sdp"
            android:text="Submit"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="@dimen/_12sdp"
            android:textAlignment="center"
            android:background="@drawable/signupback"/>


        <TextView
            android:id="@+id/count_down_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/text_color"
            android:textSize="@dimen/_12sdp"
            android:text="00:00"
            />




    </LinearLayout>


</ScrollView>