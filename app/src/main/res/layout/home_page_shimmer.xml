<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/description"
        android:src="@drawable/home_circle_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/llSimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_25sdp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:backgroundTint="@color/simmerColor"
            android:src="@drawable/ic_notification"
            app:cardCornerRadius="@dimen/_100sdp"
            app:cardElevation="0dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="1dp"
            android:backgroundTint="@color/simmerColor"
            app:cardCornerRadius="@dimen/_100sdp"
            app:cardElevation="0dp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/llSimmer"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:orientation="vertical">



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Hey, "
                android:textSize="@dimen/_18sdp" />



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Let's start exploring"
            android:textSize="@dimen/_18sdp" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:backgroundTint="@color/simmerColor"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="0dp" />


        <RelativeLayout
            android:layout_marginTop="@dimen/_10sdp"
            android:id="@+id/rl_featured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/rv_home_sale">

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_30sdp"
                android:fontFamily="@font/poppins_medium"
                android:backgroundTint="@color/simmerColor"
                android:textSize="@dimen/_18sdp" />





        </RelativeLayout>



        <androidx.cardview.widget.CardView
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_width="@dimen/_250sdp"
            android:layout_height="@dimen/_150sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_margin="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_25sdp"
            android:backgroundTint="@color/simmerColor"
            app:cardElevation="0dp"/>

        <RelativeLayout
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/rv_home_sale">

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_30sdp"
                android:fontFamily="@font/poppins_medium"
                android:backgroundTint="@color/simmerColor"
                android:textSize="@dimen/_18sdp" />





        </RelativeLayout>





    </LinearLayout>


</RelativeLayout>