<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_10sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F5F4F8"
        app:cardCornerRadius="@dimen/_15sdp">

       <ImageView
           android:scaleType="fitXY"
           android:layout_width="@dimen/_55sdp"
           android:layout_height="@dimen/_55sdp"
           android:layout_marginTop="@dimen/_10sdp"
           android:layout_marginLeft="@dimen/_10sdp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_80sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#252B5C"
                android:textStyle="bold"
                android:textSize="@dimen/_12sdp"
                android:text="Kurt Mullins"/>
            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_70sdp"
                android:src="@drawable/star_back_white"/>
            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_2sdp"
                android:src="@drawable/star_back_white"/>
            <ImageView
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_2sdp"
            android:src="@drawable/star_back_white"/>
            <ImageView
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_2sdp"
            android:src="@drawable/star_back_white"/>
            <ImageView
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_2sdp"
            android:src="@drawable/star_icon"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_80sdp"
                android:textColor="#53587A"
                android:textSize="@dimen/_8sdp"
                android:text="Lorem ipsum dolar sit amet. consectetur"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="#53587A"
                android:textSize="@dimen/_8sdp"
                android:text="adipiscing elit,sed do eiusmod tempor incididunt"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="#53587A"
                android:textSize="@dimen/_8sdp"
                android:text=" ut labore et dolore magna aliqua."/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:textColor="#53587A"
                android:textSize="@dimen/_8sdp"
                android:text="8 Days ago"/>




        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>