<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.MainFragment.PayAccountFragment">
     <LinearLayout
         android:orientation="vertical"
         android:layout_width="match_parent"
         android:layout_height="match_parent">
         <LinearLayout
             android:id="@+id/ln1"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical">
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="Bank Account Number" />
             <EditText
                 android:id="@+id/et_bank_account_no"
                 style="@style/editTextNonBrokerage"
                 android:hint="Enter bank's account number"
                 android:drawableStart="@drawable/mdi_account_key_outline"
                 android:inputType="number"
                 android:maxLength="16"/>
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="Confirm Account Number" />
             <EditText
                 android:id="@+id/et_confirm_account_no"
                 style="@style/editTextNonBrokerage"
                 android:hint="Re-enter bank's account number"
                 android:drawableStart="@drawable/mdi_account_key_outline"
                 android:inputType="number"
                 android:maxLength="16" />
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="IFSC Code" />
             <EditText
                 android:id="@+id/et_IFSC_code"
                 style="@style/myEditText"
                 android:maxLength="11"
                 android:hint="e.g. KKBK0000430"
                 android:drawableStart="@drawable/mdi_account_key_outline"
                 android:inputType="textCapCharacters"/>
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="BHK Type" />
             <TextView
                 android:id="@+id/tv_bhktype"
                 style="@style/editTextNonBrokerage"
                 android:hint="1RK"
                 android:gravity="center"
                 android:textAlignment="textStart"
                 android:drawableStart="@drawable/bx_home"
                 tools:ignore="RtlCompat" />
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="Property Address" />
             <EditText
                 android:id="@+id/propertaddress"
                 style="@style/myEditText"
                 android:hint="Enter address"
                 android:drawableStart="@drawable/tabler_address_book"
                 android:inputType="text" />
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="Rent Amount" />
             <EditText
                 android:id="@+id/rentamount"
                 style="@style/editTextNonBrokerage"
                 android:hint="Enter amount"
                 android:drawableStart="@drawable/ic_baseline_currency_rupee"
                 android:inputType="number"
                 android:maxLength="9"/>
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="Beneficiary's PAN" />
             <EditText
                 android:id="@+id/beneficiaryPan"
                 style="@style/editTextNonBrokerage"
                 android:hint="Enter your beneficiary's PAN"
                 android:drawableStart="@drawable/solar_card_2_outline"
                 android:inputType="textCapCharacters"
                 android:textAllCaps="true"
                 android:maxLength="10"/>
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="Tenant's PAN (Required if amount > 50k)" />
             <EditText
                 android:id="@+id/tenantpan"
                 style="@style/editTextNonBrokerage"
                 android:hint="Enter your own PAN number"
                 android:drawableStart="@drawable/solar_card_2_outline"
                 android:inputType="textCapCharacters"
                 android:textAllCaps="true"
                 android:maxLength="10"/>
             <TextView
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/poppins_bold"
                 android:text="Upload Rental Agreement (optional)" />
         </LinearLayout>
         <LinearLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:layout_marginBottom="@dimen/_40sdp"
             >
             <TextView
                 android:id="@+id/tv_choose_file"
                 android:padding="@dimen/_5sdp"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="choose file"
                 android:textColor="@color/white"
                 android:background="@color/greenCreateAccount"
                 android:layout_marginStart="15dp"
                 />
             <TextView
                 android:id="@+id/tv_file_name"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="No file chosen"
                 android:layout_marginStart="9dp"
                 />
             <ImageView
                 android:id="@+id/imgfetch"
                 android:scaleType="fitXY"
                 android:layout_width="@dimen/_100sdp"
                 android:layout_height="@dimen/_100sdp"/>

         </LinearLayout>

         <TextView
             android:id="@+id/tv_Save_Payment"
             android:layout_width="@dimen/_150sdp"
             android:layout_height="@dimen/_40sdp"
             android:background="@drawable/backgroundcolor"
             android:text="Pay Rent"
             android:textColor="@color/white"
             android:padding="@dimen/_10sdp"
             android:fontFamily="@font/poppins_medium"
             android:layout_marginBottom="@dimen/_70sdp"
             android:layout_gravity="center"
             android:gravity="center"/>
     </LinearLayout>

</ScrollView>