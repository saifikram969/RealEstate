<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_margin="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <androidx.cardview.widget.CardView
                app:cardCornerRadius="@dimen/_10sdp"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_150sdp">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageView
                        android:src="@drawable/home_ph"
                        android:id="@+id/searchImage"
                        android:scaleType="fitXY"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <ImageView
                        style="@style/likeButton"
                        android:id="@+id/img_favourit_icon"
                        android:contentDescription="@string/likeHeart" />

                    <androidx.cardview.widget.CardView
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="@dimen/_10sdp"
                        app:cardCornerRadius="@dimen/_5sdp"
                        android:backgroundTint="#234F68"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:padding="@dimen/_5sdp"
                            android:id="@+id/property_category_search"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/white"/>

                    </androidx.cardview.widget.CardView>






                </RelativeLayout>
            </androidx.cardview.widget.CardView>



            <LinearLayout
                android:padding="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:gravity="start|center"
                    android:id="@+id/tv_bridgeland"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#252B5C"
                    android:lines="2"
                    android:textSize="@dimen/_15sdp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Bridgeland"/>
                
                <LinearLayout
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        />

                    <LinearLayout
                        android:layout_marginStart="@dimen/_5sdp"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_locationCity_search"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:text="jkfg hfgfgfgsdgfsd g"
                            android:textSize="@dimen/_10sdp"
                            android:maxLines="@integer/material_motion_duration_long_1"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#53587A" />

                        <TextView
                            android:id="@+id/tv_locationState_search"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:textSize="@dimen/_10sdp"
                            android:text="ghghjghhghjjh"
                            android:maxLines="@integer/material_motion_duration_long_1"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#53587A"/>

                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                   <!-- <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="@integer/material_motion_duration_long_1"/>-->

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/Darkblue"
                        android:fontFamily="@font/poppins_bold"
                        android:text="gsghf sdhgfsgdhfs"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#252B5C"
                        android:fontFamily="@font/poppins_medium"
                        android:text="/month"/>


                </LinearLayout>





            </LinearLayout>


        </LinearLayout>



    </androidx.cardview.widget.CardView>


</LinearLayout>