<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.AddProperty.AddListingAddressFragment">

    <ScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">




            <TextView
                style="@style/addPropertyTextStyle"
                android:text="Phone Number"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/countryCodeAdd"
                    style="@style/myEditText"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_55sdp"
                    android:text="+91"
                    android:padding="@dimen/_10sdp"
                    android:gravity="center"/>


                <EditText
                    android:id="@+id/et_phone"
                    style="@style/myEditText"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:drawableStart="@drawable/call"
                    android:hint="Enter mobile number"
                    android:inputType="number"
                    android:maxLength="10"/>


            </LinearLayout>

            <TextView
                style="@style/addPropertyTextStyle"
                android:text="Address line 1"/>

            <EditText
                style="@style/addPropertyEditTextStyle"
                android:id="@+id/et_address"
                android:textColorHint="#808080"
                android:drawableStart="@drawable/bx_home"
                android:inputType="textCapSentences"
                android:hint="Address"/>

            <TextView
                style="@style/addPropertyTextStyle"
                android:text="Address line 2"/>

            <EditText
                style="@style/addPropertyEditTextStyle"
                android:id="@+id/et_address2"
                android:inputType="textCapSentences"
                android:textColorHint="#808080"
                android:drawableStart="@drawable/bx_home"
                android:hint="Address"/>

            <TextView
                style="@style/addPropertyTextStyle"
                android:text="State"/>

            <LinearLayout
                android:id="@+id/ll_state"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/edittext"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:src="@drawable/icon_park_outline_city" />


                <TextView
                    android:id="@+id/tv_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:paddingStart="@dimen/_10sdp"
                    android:text="State"
                    android:fontFamily="@font/poppins_medium"
                    android:textColorHint="@color/Darkblue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/addPropertyTextStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:text="City"/>

                <TextView
                    style="@style/addPropertyTextStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:text="Pincode" />
            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_city"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:background="@drawable/edittext"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:src="@drawable/icon_park_outline_city" />

                    <TextView
                        android:id="@+id/tv_city"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_weight="@integer/material_motion_duration_long_1"
                        android:background="@drawable/edittext"
                        android:paddingStart="@dimen/_10sdp"
                        android:text="City"
                        android:fontFamily="@font/poppins_medium"
                        android:singleLine="true"
                        android:textColorHint="@color/Darkblue" />


                </LinearLayout>

                <EditText
                    android:id="@+id/et_pincode"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:background="@drawable/edittext"
                    android:drawableStart="@drawable/ic_pincode"
                    android:drawablePadding="@dimen/_10sdp"
                    android:hint="Pincode"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingStart="@dimen/_10sdp"
                    android:lines="1"
                    android:textColorHint="@color/Darkblue"/>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/ll_next_btn"
                android:layout_marginBottom="@dimen/_150sdp"
                android:gravity="center"
                android:layout_alignParentBottom="true"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/in_next_btn"
                    layout="@layout/item_back_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            </LinearLayout>


        </LinearLayout>

    </ScrollView>





</RelativeLayout>