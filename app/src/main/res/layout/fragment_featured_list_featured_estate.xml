<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.FeaturedListFeaturedEstateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <include
            android:id="@+id/common_toolbar"
            layout="@layout/common_toolbar"/>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Featured Estates"
            android:textSize="@dimen/_25sdp"
            android:layout_marginLeft="@dimen/_12sdp"
            android:textColor="#252B5C"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginLeft="@dimen/_12sdp"
            android:textSize="@dimen/_12sdp"
            android:text="Our recommended real estate exclusive for you."/>

        <EditText
            android:id="@+id/et_search_bar_featured"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/edittext"
            android:drawableEnd="@drawable/ic_search"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="Search House, Apartment, etc"
            android:inputType="text"
            android:padding="@dimen/_15sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_featured_property"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/_12sdp"
                android:textSize="@dimen/_15sdp"
                android:text="70"
                android:textColor="#204D6C"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:textSize="@dimen/_15sdp"
                android:text=" estates"/>




        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_featured_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>



    </LinearLayout>
</ScrollView>