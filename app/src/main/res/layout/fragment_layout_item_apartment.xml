<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/_8sdp"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#F5F4F8"
        android:elevation="0dp"
        app:cardCornerRadius="@dimen/_19sdp"
        >
        <LinearLayout
            android:padding="@dimen/_10sdp"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            >

            <androidx.cardview.widget.CardView
                android:layout_width="135dp"
                android:layout_height="135dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/shape"
                        />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/component_6"
                        android:layout_marginHorizontal="100dp"
                        android:layout_marginTop="8dp"
                       />



                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Laurels Villa"
                android:textAlignment="center"
                android:textColor="#252B5C"
                android:textSize="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textStyle=""
                android:layout_marginTop="8dp">

            </TextView>
            <RelativeLayout
                android:id="@+id/relativeLayout4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/building_image"
                app:layout_constraintTop_toBottomOf="@+id/relativeLayout3">


                <RelativeLayout
                    android:layout_centerVertical="true"
                    android:id="@+id/relativeLayout3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_centerVertical="true"
                        android:id="@+id/yello_star"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/star___small"
                        />
                    <TextView
                        android:id="@+id/rating_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_7sdp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:layout_toEndOf="@id/yello_star"
                        android:fontFamily="@font/poppins_medium"
                        android:text="4.9" />
                </RelativeLayout>

                <ImageView
                    android:id="@+id/location_icon"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_7sdp"
                    android:contentDescription="@string/description"
                    android:scaleType="centerInside"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/relativeLayout3"
                    android:src="@drawable/location" />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_1sdp"
                    android:layout_toEndOf="@id/location_icon"
                    android:text="Bali, Indonesia"
                    android:textSize="9dp" />

            </RelativeLayout>


        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>