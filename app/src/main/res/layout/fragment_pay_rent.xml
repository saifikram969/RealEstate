<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.MainFragment.PayRentFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_30sdp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:src="@drawable/back_button_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_40sdp"
                android:fontFamily="@font/poppins_bold"
                android:text="Payment Details"
                android:textAlignment="center"
                android:textSize="@dimen/_18sdp"

                />


        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:fontFamily="@font/poppins_bold"
            android:text="Landlord Name (as per bank records)" />

        <EditText
            android:id="@+id/et_land_lordname"
            style="@style/editTextNonBrokerage"
            android:drawableStart="@drawable/solar_user_circle_linear"
            android:hint="Enter name"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_bold"
            android:text="Landlord Number" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/countryCodePicker"
                style="@style/myEditText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_55sdp"
                android:gravity="center"
                android:text="+91" />


            <EditText
                android:id="@+id/et_phone_number"
                style="@style/editTextNonBrokerage"
                android:layout_marginStart="@dimen/_2sdp"
                android:drawableStart="@drawable/call"
                android:hint="Enter mobile number"
                android:inputType="number"
                android:maxLength="10" />


        </LinearLayout>




        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_bold"
            android:text="Choose payment mode" />

        <LinearLayout
            android:layout_margin="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_rb_bank_account"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@drawable/radiounselected"
                    android:id="@+id/iv_bank_account"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    />

                <TextView
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To Bank Account" />


            </LinearLayout>

         <LinearLayout
             android:id="@+id/ll_rb_bank_upi"
             android:layout_weight="@integer/material_motion_duration_long_1"
             android:layout_width="0dp"
             android:layout_height="wrap_content">
             <ImageView
                 android:id="@+id/iv_upi_id"
                 android:src="@drawable/radiounselected"
                 android:layout_width="@dimen/_24sdp"
                 android:layout_height="@dimen/_24sdp" />

             <TextView
                 android:fontFamily="@font/poppins_semibold"
                 android:layout_gravity="center"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="To UPI ID"  />

         </LinearLayout>





        </LinearLayout>


        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        </androidx.fragment.app.FragmentContainerView>


    </LinearLayout>
</ScrollView>
