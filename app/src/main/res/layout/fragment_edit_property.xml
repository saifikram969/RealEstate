<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.btjnonbrokerage.Fragment.EditPropertyFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:layout_marginTop="@dimen/_25sdp"
            android:background="@color/white"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:padding="@dimen/_5sdp">

            <androidx.cardview.widget.CardView
                android:id="@+id/toolbar_back"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                app:cardBackgroundColor="@color/grayRealEstate"
                app:cardCornerRadius="@dimen/_100sdp"
                app:cardElevation="0dp">

                <ImageView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@string/description"
                    android:src="@drawable/ic_back" />

            </androidx.cardview.widget.CardView>


            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/real_estate"
                android:textAlignment="center"
                android:textSize="@dimen/_15sdp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_toolbar_delete"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/_10sdp"
                app:cardBackgroundColor="@color/grayRealEstate"
                app:cardCornerRadius="@dimen/_100sdp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/delete" />

            </androidx.cardview.widget.CardView>
        </RelativeLayout>


        <EditText
            android:id="@+id/et_house_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="5dp"
            android:layout_weight="@integer/material_motion_duration_long_1"
            android:background="@drawable/edittext"
            android:drawableEnd="@drawable/house"
            android:hint="Enter your house name"
            android:inputType="textCapSentences"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:textSize="@dimen/_15sdp" />

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Enter Property Description" />


        <EditText
            android:layout_marginEnd="@dimen/_10sdp"
            android:id="@+id/et_property_description"
            style="@style/addPropertyEditTextStyle"
            android:drawableStart="@drawable/bx_home"
            android:hint="3 BHK in a posh colony"
            android:inputType="textCapSentences"
            android:textColorHint="#808080" />



        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Property Available From" />

        <LinearLayout
            android:id="@+id/ll_available_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/tv_available_from_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@null"
                android:hint="Ex : 12/11/2002"
                android:inputType="number"
                android:padding="10dp"
                android:textSize="@dimen/_15sdp" />

        </LinearLayout>

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Area(sq.ft)" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp">

            <EditText
                android:id="@+id/et_property_area"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@null"
                android:hint="100/sq.ft"
                android:inputType="number"
                android:maxLength="13"
                android:padding="10dp"

                android:textSize="@dimen/_15sdp" />

            />
        </LinearLayout>

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Select Property category" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">

            <TextView
                android:id="@+id/tv_category_house"
                android:layout_width="128.8dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="House"
                android:textColor="#252B5C" />

            <TextView
                android:id="@+id/tv_category_apartment"
                android:layout_width="128.8dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Apartment"
                android:textColor="#252B5C" />

            <TextView
                android:id="@+id/tv_category_flat"
                android:layout_width="128.8dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Flat"
                android:textColor="#252B5C" />

        </LinearLayout>

        </HorizontalScrollView>

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Select Property Type"/>

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_type_furnished"
                    android:layout_width="128.8dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/yearlybuttoncolor"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Furnished"
                    android:textColor="#252B5C" />

                <TextView
                    android:id="@+id/tv_type_semifurnished"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/yearlybuttoncolor"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Semi-Furnished"
                    android:textColor="#252B5C" />

                <TextView
                    android:id="@+id/tv_type_unfurnished"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/yearlybuttoncolor"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="UnFurnished"
                    android:textColor="#252B5C" />

            </LinearLayout>

        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        </HorizontalScrollView>

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Phone Number" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCountryCode"
                style="@style/myEditText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_55sdp"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="+91" />


            <EditText
                android:id="@+id/et_phone"
                style="@style/myEditText"
                android:layout_marginStart="@dimen/_2sdp"
                android:drawableStart="@drawable/call"
                android:hint="Enter mobile number"
                android:inputType="number"
                android:maxLength="10" />


        </LinearLayout>

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Address line 1" />

        <EditText
            android:id="@+id/et_address"
            style="@style/addPropertyEditTextStyle"
            android:drawableStart="@drawable/bx_home"
            android:hint="Address"
            android:inputType="textCapSentences"
            android:textColorHint="#808080" />

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="Address line 2" />

        <EditText
            android:id="@+id/et_address2"
            style="@style/addPropertyEditTextStyle"
            android:drawableStart="@drawable/bx_home"
            android:hint="Address"
            android:inputType="textCapSentences"
            android:textColorHint="#808080" />

        <TextView
            style="@style/addPropertyTextStyle"
            android:text="State" />

        <LinearLayout
            android:id="@+id/ll_state"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:background="@drawable/edittext"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:src="@drawable/icon_park_outline_city" />


            <TextView
                android:id="@+id/tv_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:fontFamily="@font/poppins_medium"
                android:paddingStart="@dimen/_10sdp"
                android:text="State"
                android:textColorHint="@color/Darkblue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/addPropertyTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:text="City" />

            <TextView
                style="@style/addPropertyTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:text="Pincode" />
        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_city"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@drawable/edittext"
                android:gravity="center"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:src="@drawable/icon_park_outline_city" />

                <TextView
                    android:id="@+id/tv_city"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:background="@drawable/edittext"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingStart="@dimen/_10sdp"
                    android:singleLine="true"
                    android:text="City"
                    android:textColorHint="@color/Darkblue" />


            </LinearLayout>

            <EditText
                android:id="@+id/et_pincode"
                android:layout_width="0dp"
                android:layout_height="@dimen/_50sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@drawable/edittext"
                android:drawableStart="@drawable/ic_pincode"
                android:drawablePadding="@dimen/_10sdp"
                android:hint="Pincode"
                android:inputType="number"
                android:lines="1"
                android:maxLength="6"
                android:paddingStart="@dimen/_10sdp"
                android:textColorHint="@color/Darkblue" />

        </LinearLayout>


        <TextView
            style="@style/addPropertyTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Facing" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">


            <androidx.cardview.widget.CardView
                android:id="@+id/back_card"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                app:cardBackgroundColor="#A1A5C1"
                app:cardCornerRadius="@dimen/_15sdp">

                <ImageView
                    android:id="@+id/ivBackwardFashing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_arrow_back" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_facing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:text="North"
                android:textAlignment="center"
                android:textSize="20dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/ForwardCard"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                app:cardBackgroundColor="#A1A5C1"
                app:cardCornerRadius="@dimen/_15sdp">


                <ImageView
                    android:id="@+id/ivForwardFashing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_arrow_forward_ios_24" />

            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textColor="#252B5C"
                android:textSize="@dimen/_20sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" photos"
                android:textColor="#1F4C6B"
                android:textSize="@dimen/_20sdp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" to your"
                android:textColor="#252B5C"
                android:textSize="@dimen/_20sdp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="listing"
            android:textColor="#252B5C"
            android:textSize="@dimen/_20sdp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_property_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_32sdp"
            android:scrollbars="none" />


        <androidx.cardview.widget.CardView
            android:id="@+id/cv_add_img"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_5sdp"
            app:cardBackgroundColor="@color/grayRealEstate"
            app:cardCornerRadius="@dimen/_25sdp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/add_photos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_add" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Rent Price"
            android:textColor="#252B5C"
            android:textSize="@dimen/_15sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/_8sdp">


            <EditText
                android:id="@+id/et_rent_price"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@null"
                android:hint="Rent Price"
                android:inputType="number"
                android:padding="10dp"
                android:textSize="@dimen/_15sdp" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="110dp"
                android:layout_height="60dp"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="34dp"
                android:background="@drawable/monthlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Monthly"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="110dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="34dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Yearly"
                android:textColor="#252B5C" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Security Deposit"
            android:textColor="#252B5C"
            android:textSize="@dimen/_15sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_10sdp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_15_days"
                android:layout_width="120.8dp"
                android:layout_height="67dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="15 Days"
                android:textColor="#252B5C" />

            <TextView
                android:id="@+id/tv_1_month"
                android:layout_width="168.5dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="1 Month"
                android:textColor="#252B5C" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_2_month"
                android:layout_width="120.8dp"
                android:layout_height="67dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="2 Month"
                android:textColor="#252B5C" />

            <TextView
                android:id="@+id/tv_custom"
                android:layout_width="168.5dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/yearlybuttoncolor"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Custom"
                android:textColor="#252B5C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_security_deposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="center"
            android:padding="@dimen/_8sdp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_security_deposit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:background="@null"
                android:hint="4 Month"
                android:inputType="number"
                android:maxLength="13"
                android:padding="10dp"
                android:textSize="@dimen/_15sdp" />

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Property features"
            android:textColor="#252B5C"
            android:textSize="@dimen/_15sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@drawable/edittext"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/et_bedroom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_weight="@integer/material_motion_duration_long_1"
                android:hint="Bedroom"
                android:inputType="text"
                android:textColorHint="@color/Darkblue"
                android:textSize="@dimen/_15sdp" />

            <ImageView
                android:id="@+id/ivMinusBedroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/add___transparent1" />

            <TextView
                android:id="@+id/tvNoBedroom"
