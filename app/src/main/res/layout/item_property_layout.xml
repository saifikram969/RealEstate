<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_5sdp"
        app:cardBackgroundColor="#F5F4F8"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="0dp"
        app:contentPadding="@dimen/_6sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_120sdp"
                android:layout_gravity="center"
                app:cardCornerRadius="@dimen/_15sdp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_property_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="property_image"
                        android:scaleType="fitXY"
                        android:src="@drawable/shape23" />

                    <ImageView
                        android:id="@+id/iv_verify"
                        style="@style/likeButton"
                        android:contentDescription="like_icon"
                        android:src="@drawable/tickmark"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/iv_heart_icon"
                        style="@style/likeButton"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="like_icon" />

                    <TextView
                        android:layout_alignParentBottom="true"
                        android:id="@+id/property_category"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_centerHorizontal="true"
                        android:layout_margin="@dimen/_10sdp"
                        android:background="@drawable/monthlybuttoncolor"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_15sdp"
                        android:text="Apartment"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_home_sale_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/_10sdp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:textColor="@color/Darkblue" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/_2sdp">

                <ImageView
                    android:id="@+id/location_icon"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/description"
                    android:scaleType="fitXY"
                    android:src="@drawable/location" />

                <TextView
                    android:id="@+id/tv_location_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_toRightOf="@id/location_icon"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/tv_location_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_location_city"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_toEndOf="@id/location_icon"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_9sdp" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_2sdp">

                <LinearLayout
                    android:id="@+id/relativeLayout4"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ic_rupay"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:contentDescription="@string/description"
                        android:src="@drawable/ic_baseline_currency_rupee" />

                    <TextView
                        android:id="@+id/tv_pricing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/Darkblue"
                        android:textSize="@dimen/_10sdp" />
                    <TextView
                        android:id="@+id/tv_month_or_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/Darkblue"
                        android:textSize="@dimen/_8sdp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/relativeLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_2sdp">

                    <ImageView
                        android:id="@+id/yello_star"
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:contentDescription="@string/description"
                        android:src="@drawable/star_icon" />

                    <TextView
                        android:id="@+id/rating_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_9sdp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
