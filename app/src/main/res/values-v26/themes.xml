<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="editTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_50sdp</item>
        <item name="android:background">@drawable/background_myedit_text</item>
        <item name="android:drawablePadding">@dimen/_15sdp</item>
        <item name="android:padding">@dimen/_10sdp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
    <style name="countryCodePickerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_50sdp</item>
        <item name="android:background">@drawable/background_myedit_text</item>
        <item name="android:drawablePadding">@dimen/_15sdp</item>
        <item name="android:padding">@dimen/_10sdp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="greenButton">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:background">@drawable/background_green_btn</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_height">@dimen/_50sdp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CustomRatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressTint">@color/yellow</item> <!-- Set color here -->
        <item name="android:progressTintMode">src_in</item>
    </style>

    <style name="addPropertyTextStyle">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">@color/Darkblue</item>
        <item name="android:textSize">@dimen/_15sdp</item>
        <item name="android:layout_marginTop">@dimen/_10sdp</item>
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="addPropertyEditTextStyle">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:lines">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_50sdp</item>
        <item name="android:padding">@dimen/_10sdp</item>
        <item name="android:layout_marginHorizontal">@dimen/_10sdp</item>
        <item name="android:layout_weight">@integer/material_motion_duration_long_1</item>
        <item name="android:drawablePadding">@dimen/_10sdp</item>
        <item name="android:textColorHint">@color/Darkblue</item>
        <item name="android:background">@drawable/edittext</item>
    </style>

    <style name="likeButton">
        <item name="android:layout_width">@dimen/_24sdp</item>
        <item name="android:layout_height">@dimen/_24sdp</item>
        <item name="android:src">@drawable/like_heart</item>
         <item name="android:scaleType">fitXY</item>
        <item name="android:layout_margin">@dimen/_10sdp</item>
        <item name="android:contentDescription">like_icon</item>
    </style>

    <style name="propertyDetailsTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/Darkblue</item>
        <item name="android:textSize">@dimen/_15sdp</item>

    </style>

    <style name="addListingTextStyle">
        <item name="android:layout_margin">@dimen/_10sdp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/Darkblue</item>
        <item name="android:textSize">@dimen/_15sdp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>


    </style>

    <style name="editTextNonBrokerage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_55sdp</item>
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:layout_marginEnd">@dimen/_10sdp</item>
        <item name="android:layout_marginBottom">@dimen/_10sdp</item>
        <item name="android:layout_marginTop">@dimen/_10sdp</item>
        <item name="android:padding">@dimen/_10sdp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:drawablePadding">@dimen/_10sdp</item>
        <item name="android:background">@drawable/edittext</item>
    </style>

    <style name="Widget.Custom.RangeSlider" parent="Widget.Material3.Slider">
        <item name="trackColor">@color/Darkgray</item>
        <item name="thumbColor">@color/Darkblue</item>
        <item name="haloColor">@color/Darkblue</item>
    </style>

</resources>